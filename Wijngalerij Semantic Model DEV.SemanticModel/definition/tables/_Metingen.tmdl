	/// Brutomarge over de laatste 12 maanden, uit de mart.
	measure 'Brutomarge 12m' = SUM(fct_klant[brutomarge_12m])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 55ab27cd-0880-4277-9c12-1304b28c9c86

	/// Niet [Brutomarge % 12m] gebruiken: die deelt door [Omzet 12m], wat in dit model de fct_voorraad-meting is, niet de klantomzet. Levert 2,7% i.p.v. 51%.
	measure 'Brutomarge pct 12m' = DIVIDE(SUM(fct_klant[brutomarge_12m]), SUM(fct_klant[omzet_12m]))
		formatString: 0%
		lineageTag: 247bb60f-f0a1-469f-a7c3-03a9d990a4e3

