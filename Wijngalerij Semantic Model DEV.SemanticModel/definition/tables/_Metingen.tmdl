	/// YTD via dim_date[is_ytd_vergelijkbaar], niet via SAMEPERIODLASTYEAR: die verschuift zonder datumfilter de hele tabel en geeft het volledige vorige jaar terug.
	measure 'Omzet YTD dit jaar' =
			VAR Jr = YEAR([Peildatum])
			RETURN
			    CALCULATE(
			        [Omzet],
			        REMOVEFILTERS(dim_date),
			        dim_date[is_ytd_vergelijkbaar] = TRUE(),
			        dim_date[jaar] = Jr
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 0213579d-c333-44a1-9533-91bd15e49937

	/// Dezelfde kalenderperiode vorig jaar (1 jan t/m de dag van de peildatum).
	measure 'Omzet YTD vorig jaar' =
			VAR Jr = YEAR([Peildatum]) - 1
			RETURN
			    CALCULATE(
			        [Omzet],
			        REMOVEFILTERS(dim_date),
			        dim_date[is_ytd_vergelijkbaar] = TRUE(),
			        dim_date[jaar] = Jr
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: a1cf9392-c3a8-4b1c-bdf5-4b4f939fc9e6

