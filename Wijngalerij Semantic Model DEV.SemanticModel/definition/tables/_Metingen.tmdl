	/// Het hele vorige kalenderjaar, de basis onder de prognose.
	measure 'Omzet vorig jaar volledig' =
			VAR Jr = YEAR([Peildatum]) - 1
			RETURN CALCULATE([Omzet], REMOVEFILTERS(dim_date), dim_date[jaar] = Jr)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 642e6eb1-2be9-456c-b825-abf4981baab5

	/// Vorig jaar volledig maal de YTD-groei. Volgt de seizoensvorm van vorig jaar in plaats van het dagtempo tot nu toe; dat scheelt hier ruim twee ton omdat het najaar zwaarder weegt. Berust op een enkel volledig voorgaand jaar - 2024 begint pas in oktober.
	measure 'Prognose omzet jaar' =
			VAR Vorig = [Omzet vorig jaar volledig]
			VAR Groei = [Omzet YTD groei]
			RETURN IF(NOT ISBLANK(Vorig) && NOT ISBLANK(Groei), Vorig * (1 + Groei))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 7f54acd9-aa74-42b1-9aa7-be03fc5e0538

	measure 'Prognose rest van jaar' = [Prognose omzet jaar] - [Omzet YTD dit jaar]
