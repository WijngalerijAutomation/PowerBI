	/// Noemer voor de concentratiecijfers. Niet [Klanten met omzet] op fct_sales: die telt all-time en inclusief consumenten.
	measure 'Zakelijke klanten met omzet' =
			COUNTROWS(
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0
			            && fct_klant[branche] <> "Consument"
			            && NOT ISBLANK(fct_klant[branche])
			    )
			)
		formatString: #,0
		lineageTag: 3dfed271-6276-46f4-a947-74ce9e018a03

	measure 'Zakelijke omzet 12m' =
			SUMX(
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0
			            && fct_klant[branche] <> "Consument"
			            && NOT ISBLANK(fct_klant[branche])
			    ),
			    fct_klant[omzet_12m]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: eabfb34f-e2c4-4c82-8f1d-fd3401caab1e

	measure 'Aandeel top 10 pct omzet' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[omzet_12m])
			VAR Grens = ROUND(Aantal * 0.1, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[omzet_12m], DESC), fct_klant[omzet_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 11a86e9b-6a60-4a02-9953-23312e4d838b

	measure 'Aandeel top 20 pct omzet' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[omzet_12m])
			VAR Grens = ROUND(Aantal * 0.2, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[omzet_12m], DESC), fct_klant[omzet_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 80ec3b61-673e-437e-934a-bba6c11833b4

