		lineageTag: 23fb8985-93c4-41ce-98b9-75c174cc8a30

	/// is_revenue, niet is_stock_movement: gratis samples tellen niet als verkocht en de hele pagina is revenue-consistent.
	measure 'Flessen verkocht YTD dit jaar' =
			VAR Jr = YEAR([Peildatum])
			RETURN
			    CALCULATE(
			        SUM(fct_sales[aantal]),
			        fct_sales[is_revenue] = TRUE(),
			        REMOVEFILTERS(dim_date),
			        dim_date[is_ytd_vergelijkbaar] = TRUE(),
