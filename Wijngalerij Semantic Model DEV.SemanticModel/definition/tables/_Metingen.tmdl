	measure 'Marge per fles label' = FORMAT([Marge per fles], "€ #,##0.00", "nl-NL")
		lineageTag: 0d1a539b-b3bd-46df-9279-30f182af02c1

	/// Noemt het venster expliciet: de productmart is rollend 12 maanden, niet kalenderjaar zoals het CEO-dashboard.
	measure 'Producten kopregel sub' =
			VAR Eind = [Peildatum]
			VAR Startdatum = EDATE(Eind, -12) + 1
			RETURN
			    "Laatste 12 maanden · " & FORMAT(Startdatum, "d MMM yyyy", "nl-NL") & " t/m " & FORMAT(Eind, "d MMM yyyy", "nl-NL") &
			    " · " & FORMAT([Wijnen met omzet], "#,##0", "nl-NL") & " wijnen met omzet"
		lineageTag: 5eb44033-c786-44a8-929b-45ae9d403ee1

	/// Onderregel bij de producentgrafiek. Lege wijnhuis telt niet mee als producent.
	measure 'Producent aandeel sub' =
			VAR Benoemd = FILTER(ALL(fct_voorraad), fct_voorraad[omzet_12m] > 0 && NOT ISBLANK(fct_voorraad[wijnhuis]) && fct_voorraad[wijnhuis] <> "")
			VAR Totaal = CALCULATE([Omzet 12m], ALL(fct_voorraad))
			VAR PerHuis = SUMMARIZE(Benoemd, fct_voorraad[wijnhuis], "@o", CALCULATE(SUM(fct_voorraad[omzet_12m])))
			VAR Top15 = SUMX(TOPN(15, PerHuis, [@o], DESC), [@o])
			VAR Huizen = COUNTROWS(PerHuis)
			RETURN
			    "De 15 grootste wijnhuizen zijn samen goed voor " & FORMAT(DIVIDE(Top15, Totaal), "0%", "nl-NL") &
			    " van de omzet · " & FORMAT(Huizen, "#,##0", "nl-NL") & " wijnhuizen met omzet"
		lineageTag: 0483c327-e49d-4db8-90f3-3c6a2e9138dc

	/// fct_klant_product heeft geen relatie met dim_product - die is geweigerd wegens ambigue paden via fct_sales. Vandaar een expliciete sleutelvergelijking: CALCULATE op dezelfde tabel snijdt met de klantgroepering van de visual.
	measure 'Wijn klant flessen' =
			VAR Pid = SELECTEDVALUE(fct_voorraad[product_id])
			RETURN IF(NOT ISBLANK(Pid), CALCULATE(SUM(fct_klant_product[flessen_12m]), fct_klant_product[product_id] = Pid))
		formatString: #,0
		lineageTag: d40a1764-f9ed-470b-b2ad-aba5ef7a79a3

	measure 'Wijn klant omzet' =
			VAR Pid = SELECTEDVALUE(fct_voorraad[product_id])
			RETURN IF(NOT ISBLANK(Pid), CALCULATE(SUM(fct_klant_product[omzet_12m]), fct_klant_product[product_id] = Pid))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: f352f6e2-25b3-469f-8a69-24529de2d9b9

	measure 'Wijn klant laatste order' =
			VAR Pid = SELECTEDVALUE(fct_voorraad[product_id])
			VAR D = IF(NOT ISBLANK(Pid), CALCULATE(MAX(fct_klant_product[laatste_order_datum]), fct_klant_product[product_id] = Pid))
			RETURN IF(NOT ISBLANK(D), FORMAT(D, "d MMM yyyy", "nl-NL"), "")
		lineageTag: 0d411632-927e-423a-b886-152be3806c0d

	measure 'Wijn klant status' =
			VAR Pid = SELECTEDVALUE(fct_voorraad[product_id])
			RETURN IF(NOT ISBLANK(Pid), CALCULATE(SELECTEDVALUE(fct_klant_product[regelstatus]), fct_klant_product[product_id] = Pid), "")
		lineageTag: eed5fdc1-7e47-4728-833e-9357b58c962f

	/// Visual-filter voor de klantentabel op Productdetail. Vereist omzet in het venster, zodat de tabel precies de klanten toont die de kop telt en 'klanten die deze wijn kopen' ook echt kopers zijn.
	measure 'Regel hoort bij wijn' =
			VAR Pid = SELECTEDVALUE(fct_voorraad[product_id])
			VAR N =
			    IF(NOT ISBLANK(Pid),
			        CALCULATE(
			            COUNTROWS(fct_klant_product),
			            fct_klant_product[product_id] = Pid,
			            fct_klant_product[omzet_12m] > 0
			        )
			    )
			RETURN IF(NOT ISBLANK(N) && N > 0, 1, 0)
		formatString: 0
		isHidden
		lineageTag: a39fbbc4-ed9a-4208-a91f-b62561c096fc

	/// Zakelijke klanten met omzet op deze wijn in het venster. Telt precies de rijen die de tabel eronder toont, en vormt samen met klanten_vorige_12m een vergelijkbaar paar voor de groei. Niet [Klanten per wijn]: die mart-kolom telt alle klanten inclusief consumenten en ook regels zonder omzet.
	measure 'Wijn klanten in lijst' = SUM(fct_voorraad[klanten_nu_zakelijk])
		formatString: #,0
		lineageTag: abec7e5c-cdac-4903-998a-c3fd4a87ed1b

	/// Artikelcode, wijnhuis en leverancier onder de productnaam op de detailpagina.
	measure 'Wijn kopregel sub' =
			VAR Code = SELECTEDVALUE(fct_voorraad[artikelcode])
			VAR Huis = SELECTEDVALUE(fct_voorraad[wijnhuis])
			VAR Lev  = SELECTEDVALUE(fct_voorraad[leverancier])
			RETURN
			    TRIM(
			        IF(NOT ISBLANK(Code), Code, "") &
			        IF(NOT ISBLANK(Huis), " · " & Huis, "") &
			        IF(NOT ISBLANK(Lev) && Lev <> Huis, " · " & Lev, "")
			    )
		lineageTag: d0ef2be1-b3c7-4cc0-b574-9b686f4fde9b

	/// Lege string i.p.v. BLANK: een cardVisual rendert BLANK als '--'.
	measure 'Wijn naam' =
			VAR N = SELECTEDVALUE(fct_voorraad[product_label])
			RETURN IF(ISBLANK(N), "", N)
		lineageTag: b0c5100d-2724-413f-97ef-90f0c2dd2da0

	measure 'Wijn gem verkoopprijs label' =
			VAR V = CALCULATE(AVERAGE(fct_voorraad[gem_verkoopprijs_12m]))
			RETURN IF(ISBLANK(V), "", FORMAT(V, "€ #,##0.00", "nl-NL"))
		lineageTag: 67db1590-a565-4c88-9b5d-3c556e49cfea

	measure 'Wijn inkoopprijs label' =
			VAR V = CALCULATE(AVERAGE(fct_voorraad[inkoopprijs]))
			RETURN IF(ISBLANK(V), "", FORMAT(V, "€ #,##0.00", "nl-NL"))
		lineageTag: 4e44b8b3-e7b9-43bb-8dbd-e34d35154c1d

	measure 'Wijn klanten label' = FORMAT([Wijn klanten in lijst], "#,##0", "nl-NL")
		lineageTag: d2440f97-0f87-481e-9744-f6667ebfaad0

	measure 'Wijn flessen label' = FORMAT([Wijn flessen 12m], "#,##0", "nl-NL")
		lineageTag: 7a1da905-e6f8-4fa0-8bf0-5f01fed65c02

	/// Rangschikt over wijnhuis, de kolom waarop de producentgrafiek groepeert. Sluit de lege wijnhuis uit: producten zonder wijnhuis vormen geen producent en stonden anders in de top 15.
	measure 'Wijnhuis rang' =
			VAR Huis = SELECTEDVALUE(fct_voorraad[wijnhuis])
			RETURN
			    IF(
			        NOT ISBLANK(Huis) && Huis <> "" && [Omzet 12m] > 0,
			        RANKX(
			            FILTER(ALLSELECTED(fct_voorraad[wijnhuis]), NOT ISBLANK(fct_voorraad[wijnhuis]) && fct_voorraad[wijnhuis] <> ""),
			            [Omzet 12m], , DESC, DENSE
			        )
			    )
		formatString: 0
		lineageTag: ace0d330-502f-465b-a309-860bd5388f1a

	/// Visual-filter voor de producentgrafiek. Een measure-filter en geen handgeschreven TopN-Subquery in de PBIR: die heeft het rapport eerder onopenbaar gemaakt.
	measure 'Wijnhuis in top 15' =
			VAR R = [Wijnhuis rang]
			RETURN IF(NOT ISBLANK(R) && R <= 15, 1, 0)
		formatString: 0
		isHidden
		lineageTag: a86fee39-471f-404a-827c-bd5f9e3eb9f6

	/// Filter voor de wijn-slicer op Productdetail. Zonder dit staat de lege 'unknown member'-rij van dim_product in de lijst en pakt een enkelvoudige selectie die als eerste waarde, waardoor de hele pagina leeg blijft.
	measure 'Wijn selecteerbaar' =
			VAR N = SELECTEDVALUE(fct_voorraad[product_label])
			RETURN IF(NOT ISBLANK(N) && N <> "", 1, 0)
		formatString: 0
		isHidden
		lineageTag: b89c6042-a0cd-42e1-a2ec-13f7b36121e9

	measure 'Wijn omzet vorig' = SUM(fct_voorraad[omzet_vorige_12m])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: f249d396-8f57-4b42-b4df-f0245dd822b2

	measure 'Wijn flessen vorig' = SUM(fct_voorraad[flessen_vorige_12m])
		formatString: #,0
		lineageTag: f2f105a9-7b9d-4311-aae4-629f8b5853f2

	measure 'Wijn klanten vorig' = SUM(fct_voorraad[klanten_vorige_12m])
		formatString: #,0
		lineageTag: 8b20af67-c2d7-4627-9453-573c74911966

	measure 'Wijn gem verkoopprijs vorig' = DIVIDE([Wijn omzet vorig], [Wijn flessen vorig])
		lineageTag: 61c93108-c993-4cf3-8aa3-660b8df1a967

	/// Pijl plus percentage. 'nieuw' als er geen vorig venster is - een wijn die pas dit jaar is ingevoerd heeft geen zinnige groei.
	measure 'Wijn omzet groei label' =
			VAR V = [Wijn omzet vorig]
			VAR G = DIVIDE([Omzet 12m] - V, V)
			RETURN IF(ISBLANK(V) || V = 0 || ISBLANK(G), "nieuw", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: 9d8929a9-57ef-4251-a082-9c636ac63ee6

	measure 'Wijn flessen groei label' =
			VAR V = [Wijn flessen vorig]
			VAR G = DIVIDE([Wijn flessen 12m] - V, V)
			RETURN IF(ISBLANK(V) || V = 0 || ISBLANK(G), "nieuw", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: 8a662dc6-c11e-461b-8426-9bca4f4d6a7a

	/// Vergelijkt zakelijke klanten met omzet nu tegen dezelfde afbakening vorig venster - hetzelfde getal dat de kaart toont.
	measure 'Wijn klanten groei label' =
			VAR V = [Wijn klanten vorig]
			VAR N = [Wijn klanten in lijst]
			VAR G = DIVIDE(N - V, V)
			RETURN IF(ISBLANK(V) || V = 0 || ISBLANK(G), "nieuw", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: b26d59ff-70a9-40b1-82d4-16ebdbb1bb5d

	measure 'Wijn prijs groei label' =
			VAR V = [Wijn gem verkoopprijs vorig]
			VAR Nu = DIVIDE([Omzet 12m], [Wijn flessen 12m])
			VAR G = DIVIDE(Nu - V, V)
			RETURN IF(ISBLANK(V) || V = 0 || ISBLANK(G), "nieuw", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: e95f9b8d-b32c-4679-a7e1-69b896f63a0a

	measure 'Wijn omzet vergelijking' =
			VAR V = [Wijn omzet vorig]
			RETURN IF(ISBLANK(V) || V = 0, "geen vorig venster", "vs. " & FORMAT(V, "€ #,##0", "nl-NL"))
		lineageTag: ae3c722c-0d45-4396-86a1-d6eed73f68bd

	measure 'Wijn flessen vergelijking' =
			VAR V = [Wijn flessen vorig]
			RETURN IF(ISBLANK(V) || V = 0, "geen vorig venster", "vs. " & FORMAT(V, "#,##0", "nl-NL"))
		lineageTag: 289645bd-0cd7-4760-a8ec-088c24edd174

	measure 'Wijn klanten vergelijking' =
			VAR V = [Wijn klanten vorig]
			RETURN IF(ISBLANK(V) || V = 0, "geen vorig venster", "vs. " & FORMAT(V, "#,##0", "nl-NL"))
		lineageTag: b1de9934-7f8f-4e63-b73c-77d83445f702

	measure 'Wijn prijs vergelijking' =
