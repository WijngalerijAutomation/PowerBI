	/// Flessen over de laatste 52 weken uit de productmart. Consistent met omzet_12m/brutomarge_12m uit dezelfde rij.
	measure 'Wijn flessen 12m' = SUM(fct_voorraad[flessen_52w])
		formatString: #,0
		lineageTag: b7ce10cc-5020-40ab-af9c-d1edc7241259

	measure 'Marge per fles' = DIVIDE([Brutomarge], [Wijn flessen 12m])
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: f34558c3-1e15-4e76-97d6-fab115aaa689

	measure 'Klanten per wijn' = SUM(fct_voorraad[n_klanten])
