	/// Pareto-lijn over klant_label, passend bij de groepering van de grafiek.
	measure 'Cumulatief omzet pct' =
			VAR R = [Klantrang omzet]
			VAR Zichtbaar = ALLSELECTED(fct_klant[klant_label])
			VAR Totaal = CALCULATE([Klant omzet 12m], Zichtbaar)
			RETURN
			    IF(NOT ISBLANK(R),
			        DIVIDE(
			            SUMX(FILTER(Zichtbaar, [Klantrang omzet] <= R), [Klant omzet 12m]),
			            Totaal
			        )
			    )
		formatString: 0.0%
		lineageTag: d897a6ef-b981-47ee-b166-9739a9c05226

