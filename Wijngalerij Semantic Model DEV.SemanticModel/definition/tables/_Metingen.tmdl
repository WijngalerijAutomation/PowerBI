	/// Numerieke status voor Type 2 regels in de wijnentabel. Een measure, geen kolomverwijzing: een kolom in de conditie dwingt Power BI die kolom als extra rijniveau toe te voegen.
	measure Statuscode =
			SWITCH(SELECTEDVALUE(fct_klant_product[regelstatus], ""),
			    "actief", 1,
			    "gestopt", 2,
			    "kans", 3,
			    0)
		formatString: 0
		isHidden
