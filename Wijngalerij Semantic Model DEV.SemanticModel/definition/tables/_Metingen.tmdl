/// Home table for the klantdetail-desktop measures (powerbi_klantdetail_desktop.md). Contains no data.
table _Metingen
	lineageTag: d1d221cc-1f4c-42fe-b08e-4ab4de3a9121

	/// Wanneer de pipeline voor het laatst liep. Niet de peildatum.
	measure Laadtijd = CALCULATE(MAX(fct_sales[extracted_at]), ALL(fct_sales))
		formatString: General Date
		lineageTag: 9ded878b-50d2-480b-b840-9e318130ad5b

	/// Laadtijd en peildatum in een regel; zie 3.1.
	measure 'Actualiteit label' =
			"bijgewerkt " & FORMAT([Laadtijd], "d MMM HH:mm", "nl-NL")
			    & " · cijfers t/m " & FORMAT([Peildatum], "d MMM yyyy", "nl-NL")
		lineageTag: 862225de-64bd-4346-8812-2a4f2076c2db

	/// Start + 1 is bewust: fct_klant filtert strikt groter dan. Moet gelijk zijn aan SUM(fct_klant[omzet_12m]).
	measure 'Omzet 12m rollend' =
			VAR Einddatum   = [Peildatum]
			VAR Startdatum  = EDATE(Einddatum, -12)
			RETURN CALCULATE([Omzet], DATESBETWEEN(dim_date[datum], Startdatum + 1, Einddatum))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 02e8eeeb-21b1-4e21-8503-6ddb5e92a9bb

	measure 'Omzet vorige 12m rollend' =
			VAR Einddatum   = EDATE([Peildatum], -12)
			VAR Startdatum  = EDATE([Peildatum], -24)
			RETURN CALCULATE([Omzet], DATESBETWEEN(dim_date[datum], Startdatum + 1, Einddatum))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 36dbd76e-2f3d-4819-81b7-c2b33b4f45fd

	measure 'Orders 12m rollend' =
			VAR Einddatum   = [Peildatum]
			VAR Startdatum  = EDATE(Einddatum, -12)
			RETURN CALCULATE(
			    DISTINCTCOUNT(fct_sales[ordernummer]),
			    DATESBETWEEN(dim_date[datum], Startdatum + 1, Einddatum),
			    fct_sales[is_revenue] = TRUE()
			)
		formatString: #,0
		lineageTag: beb475c9-a386-4ede-8372-8a464a8f4e07

	/// is_revenue, niet is_stock_movement: consistent met fct_klant[flessen_12m].
	measure 'Flessen 12m rollend' =
			VAR Einddatum   = [Peildatum]
			VAR Startdatum  = EDATE(Einddatum, -12)
			RETURN CALCULATE(
			    SUM(fct_sales[aantal]),
			    DATESBETWEEN(dim_date[datum], Startdatum + 1, Einddatum),
			    fct_sales[is_revenue] = TRUE()
			)
		formatString: #,0
		lineageTag: 92475105-fd36-45d8-aac1-67115f747045

	measure 'Flessen vorige 12m rollend' =
			VAR Einddatum   = EDATE([Peildatum], -12)
			VAR Startdatum  = EDATE([Peildatum], -24)
			RETURN CALCULATE(
			    SUM(fct_sales[aantal]),
			    DATESBETWEEN(dim_date[datum], Startdatum + 1, Einddatum),
			    fct_sales[is_revenue] = TRUE()
			)
		formatString: #,0
		lineageTag: b3789ffb-5643-4af6-9c46-d60b4e42acff

	measure 'Gem. orderwaarde 12m rollend' = DIVIDE([Omzet 12m rollend], [Orders 12m rollend])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 234652f4-7593-4347-99a2-197d3bdebd54

	measure 'Orders per maand 12m' = DIVIDE([Orders 12m rollend], 12)
		formatString: 0.0
		lineageTag: 4434d219-e54e-4431-be9d-709367387a5e

	measure 'Flessen verschil 12m' = [Flessen 12m rollend] - [Flessen vorige 12m rollend]
		formatString: #,0
		lineageTag: 971d36b2-9cb1-4cda-ac89-ed77e15ba57f

	measure 'Dagen sinds laatste order' = SELECTEDVALUE(fct_klant[dagen_sinds_laatste_order])
		formatString: #,0
		lineageTag: bd58d279-596d-4f2b-8e23-b3f8cdb2643e

	measure 'Wijnen actief' = CALCULATE(COUNTROWS(fct_klant_product), fct_klant_product[regelstatus] = "actief")
		formatString: #,0
		lineageTag: 8e2a4b24-6ebb-44af-a72a-0c1073b2feae

	/// Huidig venster (laatste 12 mnd) - anders dan Omzet gemist.
	measure 'Omzet actief' = CALCULATE(SUM(fct_klant_product[omzet_12m]), fct_klant_product[regelstatus] = "actief")
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 98d8a316-a4df-4374-bd77-10c8ae47b1f5

	measure 'Flessen actief' = CALCULATE(SUM(fct_klant_product[flessen_12m]), fct_klant_product[regelstatus] = "actief")
		formatString: #,0
		lineageTag: de147b02-2600-499a-aa41-1f299082c6c5

	measure 'Wijnen gestopt' = CALCULATE(COUNTROWS(fct_klant_product), fct_klant_product[regelstatus] = "gestopt")
		formatString: #,0
		lineageTag: 6ebe9b57-0d85-49a8-aa30-ed66dca8604a

	/// Vorige venster (12-24 mnd) op purpose - zie 3.4.
	measure 'Omzet gemist' = CALCULATE(SUM(fct_klant_product[omzet_vorige_12m]), fct_klant_product[regelstatus] = "gestopt")
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: c41e3ca7-bc55-4249-a2aa-708475b8cfff

	measure 'Flessen gemist' = CALCULATE(SUM(fct_klant_product[flessen_vorige_12m]), fct_klant_product[regelstatus] = "gestopt")
		formatString: #,0
		lineageTag: 8b36e2e2-6e64-4e51-a114-052326802ac3

	measure 'Wijnen kans' = CALCULATE(COUNTROWS(fct_klant_product), fct_klant_product[regelstatus] = "kans")
		formatString: #,0
		lineageTag: dd53fad6-0a00-4e55-ad1f-558a0355e782

	/// Eerder besteld geld, geen potentieel - zie 3.4.
	measure 'Kans eerdere omzet' = CALCULATE(SUM(fct_klant_product[omzet_vorige_12m]), fct_klant_product[regelstatus] = "kans")
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 742291b7-fb51-4c2f-92e7-1d4176a190ad

	measure 'Kans met historie' =
			CALCULATE(
			    COUNTROWS(fct_klant_product),
			    fct_klant_product[regelstatus] = "kans",
			    fct_klant_product[omzet_vorige_12m] > 0
			)
		formatString: #,0
		lineageTag: da55e164-b4c9-4568-8229-9e8dac2fd9aa

	measure 'Omzet 12m rollend label' = FORMAT([Omzet 12m rollend], "€ #,##0", "nl-NL")
		lineageTag: d1673cb6-eb8e-4621-a5b0-61629708cad8

	measure 'Orders 12m label' = FORMAT([Orders 12m rollend], "#,##0", "nl-NL")
		lineageTag: 494c4747-b805-4414-ad98-3c0d0a113c15

	measure 'Flessen 12m label' = FORMAT([Flessen 12m rollend], "#,##0", "nl-NL")
		lineageTag: c5d25d18-d3cf-420b-84dc-fdb3c0b92e41

	/// COALESCE: FORMAT(BLANK()) geeft een lege string, waardoor de portfolio-subregel als ' · 0 fl.' rendert.
	measure 'Omzet actief label' = FORMAT(COALESCE([Omzet actief], 0), "€ #,##0", "nl-NL")
		lineageTag: ab405e7b-5ad2-40fe-a344-efaf67d4d8ed

	/// COALESCE: zie Omzet actief label.
	measure 'Omzet gemist label' = FORMAT(COALESCE([Omzet gemist], 0), "€ #,##0", "nl-NL")
		lineageTag: 9c7ea55c-060c-4592-838d-a226788151ea

	/// COALESCE: zie Omzet actief label.
	measure 'Kans eerdere omzet label' = FORMAT(COALESCE([Kans eerdere omzet], 0), "€ #,##0", "nl-NL")
		lineageTag: 4d1fdb67-36bb-4a3c-bce7-845ce1cfda1c

	measure 'Gem. orderwaarde 12m label' =
			"gem. " & FORMAT([Gem. orderwaarde 12m rollend], "€ #,##0", "nl-NL")
			    & " · " & FORMAT([Orders per maand 12m], "0.0", "nl-NL") & " per maand"
		lineageTag: 24f8973e-bfab-4978-9795-8a5ffb28fd69

	/// Meting kiest de pijl. Niet hardcoden - de mockup heeft het teken verkeerd.
	measure 'Flessen verschil label' =
			VAR V = [Flessen verschil 12m]
			RETURN SWITCH(TRUE(),
			    ISBLANK(V) || V = 0, "gelijk aan vorig jaar",
			    V > 0,  "↗ " & FORMAT(V, "#,##0", "nl-NL") & " meer dan vorig jaar",
			            "↘ " & FORMAT(ABS(V), "#,##0", "nl-NL") & " minder dan vorig jaar"
			)
		lineageTag: 7adc9dad-50c2-4b4b-b2dd-8750c5eb0da3

	/// Noemt altijd het venster. Fix voor de tegenstrijdigheid in 0.
	measure 'Groei JoJ label' =
			VAR G = [Omzet groei JoJ]
			RETURN SWITCH(TRUE(),
			    ISBLANK(G), "geen vergelijkbare basis vorig jaar",
			    G >= 0, "↗ " & FORMAT(G, "0%", "nl-NL") & " vs. zelfde 6 mnd vorig jaar",
			            "↘ " & FORMAT(ABS(G), "0%", "nl-NL") & " vs. zelfde 6 mnd vorig jaar"
			)
		lineageTag: d36b1e01-929c-419e-a223-176ad5484244

	measure 'Laatste order label' =
			VAR D = [Dagen sinds laatste order]
			RETURN SWITCH(TRUE(),
			    ISBLANK(D), "nooit besteld",
			    D = 0, "vandaag",
			    D = 1, "1 dag geleden",
			    FORMAT(D, "#,##0", "nl-NL") & " dagen geleden"
			)
		lineageTag: 25722b01-53a3-4e32-a362-b2234eecda37

	/// Lege string i.p.v. BLANK: een cardVisual rendert BLANK als '--'. Drempels: 3x eigen ritme, of -25% JoJ.
	measure Risicovlag =
			VAR R = SELECTEDVALUE(fct_klant[recency_ratio])
			VAR G = [Omzet groei JoJ]
			VAR S = SELECTEDVALUE(fct_klant[klant_segment])
			RETURN SWITCH(TRUE(),
			    S IN { "verloren", "slapend" },        UNICHAR(9888) & " Risico",
			    NOT ISBLANK(R) && R >= 3,              UNICHAR(9888) & " Risico",
			    NOT ISBLANK(G) && G <= -0.25,          UNICHAR(9888) & " Risico",
			    ""
			)
		lineageTag: 58bac0a6-9769-47f3-bc40-70a8bbf442b3

	/// Neutrale terugval i.p.v. BLANK, zie 6. Venster staat altijd in de tekst.
	measure Signaal =
			VAR G        = [Omzet groei JoJ]
			VAR NGestopt = [Wijnen gestopt]
			VAR Gemist   = [Omzet gemist]
			VAR Zin1 =
			    SWITCH(TRUE(),
			        ISBLANK(G), BLANK(),
			        G <= -0.10,
			            "Omzet daalt " & FORMAT(ABS(G), "0%", "nl-NL") &
			            " over de laatste zes maanden, tegenover dezelfde zes maanden vorig jaar.",
			        G >= 0.10,
			            "Omzet stijgt " & FORMAT(G, "0%", "nl-NL") &
			            " over de laatste zes maanden, tegenover dezelfde zes maanden vorig jaar.",
			        BLANK()
			    )
			VAR Zin2 =
			    IF(NGestopt > 0,
			        FORMAT(NGestopt, "#,##0", "nl-NL") & " wijnen gestopt, samen goed voor " &
			        FORMAT(Gemist, "€ #,##0", "nl-NL") & " omzet in de twaalf maanden daarvoor.",
			        BLANK()
			    )
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK(Zin1) && ISBLANK(Zin2),
			            "Geen bijzonderheden in de cijfers van de laatste twaalf maanden.",
			        ISBLANK(Zin1), Zin2,
			        ISBLANK(Zin2), Zin1,
			        Zin1 & UNICHAR(10) & Zin2
			    )
		lineageTag: 9c6058b9-46f8-4558-9b5d-01e0aedb42ca

	measure 'Signaal kleur' =
			VAR G = [Omzet groei JoJ]
			RETURN IF(NOT ISBLANK(G) && G <= -0.10, "#FDECEA", "#F2F5F2")
		lineageTag: 55dda75b-7658-425a-bff9-d334fb050593

	measure 'Signaal tekstkleur' =
			VAR G = [Omzet groei JoJ]
			RETURN IF(NOT ISBLANK(G) && G <= -0.10, "#A2515F", "#1B2523")
		lineageTag: dcbcbbcf-eec4-4d3f-abf2-4360e67ee838

	measure Statuslabel =
			VAR S = SELECTEDVALUE(fct_klant_product[regelstatus], "meerdere")
			VAR D = MAX(fct_klant_product[laatste_order_datum])
			RETURN SWITCH(S,
			    "actief",      "Actief",
			    "gestopt",     "Gestopt · " & FORMAT(D, "mmm yy", "nl-NL"),
			    "kans",        "Kans",
			    "incidenteel", "Incidenteel",
			    S
			)
		lineageTag: 47ae4736-9c0c-4fd9-a43c-0c2115c786d7

	measure 'Flessen tabel' =
			VAR S = SELECTEDVALUE(fct_klant_product[regelstatus], "meerdere")
			RETURN IF(S IN { "gestopt", "kans" },
			    SUM(fct_klant_product[flessen_vorige_12m]),
			    SUM(fct_klant_product[flessen_12m])
			)
		formatString: #,0
		lineageTag: 5d460b73-bfff-460c-aa23-2c75c721b659

	/// Mengt twee vensters in een kolom - zie 3.8.
	measure 'Omzet tabel' =
			VAR S = SELECTEDVALUE(fct_klant_product[regelstatus], "meerdere")
			RETURN IF(S IN { "gestopt", "kans" },
			    SUM(fct_klant_product[omzet_vorige_12m]),
			    SUM(fct_klant_product[omzet_12m])
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 577bb4c1-88c8-4f51-86c3-6222564b3620

	measure Sorteerwaarde =
			MAX(
			    SUM(fct_klant_product[omzet_12m]),
			    SUM(fct_klant_product[omzet_vorige_12m])
			)
		isHidden
		lineageTag: 8fda9306-bc12-4c71-8a49-d76f0c0581c4

	measure 'Wijnen actief label' = FORMAT(COALESCE([Wijnen actief], 0), "#,##0", "nl-NL") & " wijnen"
		lineageTag: 0e7403f7-702f-4a6d-955b-cb039b1ffbef

	/// COALESCE: Wijnen gestopt is BLANK zonder gestopte wijnen, anders leest de tegel als ' wijnen'.
	measure 'Wijnen gestopt label' = FORMAT(COALESCE([Wijnen gestopt], 0), "#,##0", "nl-NL") & " wijnen"
		lineageTag: 872b7bb1-b2b4-49c5-9d45-2251dc144cc3

	measure 'Wijnen kans label' = FORMAT(COALESCE([Wijnen kans], 0), "#,##0", "nl-NL") & " wijnen"
		lineageTag: 8dd60a23-e83d-4819-819a-feecb35ceb07

	/// MIN, niet MAX. EOMONTH i.p.v. EDATE voor de startgrens: EDATE(-13) valt op 10 juli, waardoor de meting per dag geevalueerd 13 maanden teruggeeft (halve juli 2025). EOMONTH geeft 31 juli en klopt op zowel dag- als maandniveau. Optie 1 uit 8.3.
	measure 'In laatste 12 maanden' =
			VAR Einddatum  = [Peildatum]
			VAR Startdatum = EOMONTH(Einddatum, -13)
			VAR M          = MIN(dim_date[datum])
			RETURN IF(M > Startdatum && M <= EOMONTH(Einddatum, -1), 1, 0)
		lineageTag: 41c4ada6-a5ca-4d9f-bf3f-85bfd17578fc

	/// IF-guard: zonder klantselectie blank, waardoor Power BI de knop uitschakelt.
	measure 'Pierre verkoopadvies' =
			VAR KlantId = SELECTEDVALUE(dim_customer[klant_id])
			RETURN
			    IF(NOT ISBLANK(KlantId),
			        "https://wijngalerij-agent.fly.dev/?klant=" & KlantId & "&vraag=verkoopadvies")
		lineageTag: 1c3b4bef-aecf-45dd-9e9b-54c5633fa58c

	/// Geen DATESBETWEEN: die wist als time-intelligence functie alle filters op dim_date (ook maand_naam), waardoor elke maand het 24-maands totaal gaf. FILTER op alleen dim_date[datum] laat de maandfilter staan.
	measure Piekmaanden =
			VAR Einddatum  = [Peildatum]
			VAR Startdatum = EDATE(Einddatum, -24)
			VAR PerMaand =
			    ADDCOLUMNS(
			        VALUES(dim_date[maand_naam]),
			        "@Omzet",
			        CALCULATE(
			            [Omzet],
			            KEEPFILTERS(
			                FILTER(
			                    ALL(dim_date[datum]),
			                    dim_date[datum] > Startdatum && dim_date[datum] <= Einddatum
			                )
			            )
			        )
			    )
			VAR Top2 = TOPN(2, PerMaand, [@Omzet], DESC)
			RETURN
			    IF(HASONEVALUE(dim_customer[klant_naam]),
			        "Piekmaanden over de laatste twee jaar: "
			        & CONCATENATEX(Top2, dim_date[maand_naam], " en ", [@Omzet], DESC) & ".")
		lineageTag: 68675a8d-3c77-4e16-9fea-0339cd002377

	measure 'Grootste verlies' =
			VAR Rij = TOPN(1,
			    FILTER(fct_klant_product, fct_klant_product[regelstatus] = "gestopt"),
			    fct_klant_product[omzet_vorige_12m], DESC)
			VAR Naam   = MAXX(Rij, fct_klant_product[product_naam])
			VAR Bedrag = MAXX(Rij, fct_klant_product[omzet_vorige_12m])
			VAR Datum  = MAXX(Rij, fct_klant_product[laatste_order_datum])
			RETURN IF(NOT ISBLANK(Naam),
			    "Grootste weggevallen wijn: " & Naam & " — " &
			    FORMAT(Bedrag, "€ #,##0", "nl-NL") & " in de twaalf maanden ervoor, laatst besteld " &
			    FORMAT(Datum, "d MMMM yyyy", "nl-NL") & ".")
		lineageTag: 0832e7b4-fb0b-4b2d-9266-8ce71012ca0d

	measure 'Kopregel sub' =
			VAR Branche = SELECTEDVALUE(fct_klant[branche])
			VAR Plaats  = SELECTEDVALUE(fct_klant[plaats])
			VAR AM      = SELECTEDVALUE(fct_klant[accountmanager])
			VAR Mail    = SELECTEDVALUE(fct_klant[email])
			VAR Delen =
			    FILTER(
			        { Branche, Plaats, IF(NOT ISBLANK(AM), "Accountmanager " & AM), Mail },
			        NOT ISBLANK([Value]) && [Value] <> ""
			    )
			RETURN CONCATENATEX(Delen, [Value], " · ")
		lineageTag: 614aa07a-0c51-421c-b7c2-8ddd541f4110

	measure 'Peildatum label' = "Cijfers per " & FORMAT([Peildatum], "d MMMM yyyy", "nl-NL")
		lineageTag: 6626861a-6d05-4393-878a-ec8dd3bc8066

	/// Card Data-rol accepteert alleen measures, geen kolommen (PBIR_ROLE_KIND_MISMATCH).
	measure Klantnaam = SELECTEDVALUE(dim_customer[klant_naam], "Meerdere klanten")
		lineageTag: 05322f8b-2b26-4cfa-841b-472ca9f48e3a

	/// Idem, en levert meteen het formaat d MMM yyyy uit 5.
	measure 'Laatste order datum label' =
			VAR D = SELECTEDVALUE(fct_klant[laatste_order_datum])
			RETURN IF(NOT ISBLANK(D), FORMAT(D, "d MMM yyyy", "nl-NL"))
		lineageTag: 7fec11eb-1872-425e-90ba-17af999c7438

	/// Badge-tekst voor de kopregel (5).
	measure 'Segment badge' = SELECTEDVALUE(fct_klant[klant_segment])
		lineageTag: c45e592f-c6c9-45c1-9d65-3df9156a43c2

	/// Zonder de ',-' suffix van [Omzet YTD label], anders leest tegel B anders dan de andere drie.
	measure 'Omzet YTD tegel label' = FORMAT([Omzet YTD], "€ #,##0", "nl-NL")
		lineageTag: 912fa3e4-1423-48a0-b5ef-057c865e319c

	/// Eerlijke subregel voor tegel B: er is geen jaardoel in het warehouse (8.4).
	measure 'YTD periode label' = "1 jan t/m " & FORMAT([Peildatum], "d MMM yyyy", "nl-NL")
		lineageTag: 73307f61-8e7d-49e5-b8f6-e002f08e9316

	/// Lege string als er geen vergelijkbare basis is: 'Geen vergelijkbare basis' is geen conclusie, en samen met een lege regel 2 verdwijnt de hele banner via signaal_kleur = wit.
	measure 'Signaal regel 1' =
			VAR G        = [Omzet groei JoJ]
			VAR NGestopt = COALESCE([Wijnen gestopt], 0)
			RETURN
			    SWITCH(TRUE(),
			        NOT ISBLANK(G) && G <= -0.10,
			            "Omzet daalt " & FORMAT(ABS(G), "0%", "nl-NL") &
			            " over de laatste zes maanden, tegenover dezelfde zes maanden vorig jaar.",
			        NOT ISBLANK(G) && G >= 0.10,
			            "Omzet stijgt " & FORMAT(G, "0%", "nl-NL") &
			            " over de laatste zes maanden, tegenover dezelfde zes maanden vorig jaar.",
			        NOT ISBLANK(G),
			            "Omzet is stabiel tegenover dezelfde zes maanden vorig jaar.",
			        NGestopt > 0, "",
			        "Geen bijzonderheden in de cijfers van de laatste twaalf maanden."
			    )
		lineageTag: 24ecc6a4-d112-4e4a-afe1-2ef510eb4d25

	/// Lege string i.p.v. BLANK: een cardVisual rendert BLANK als '--' op de tweede bannerregel.
	measure 'Signaal regel 2' =
			VAR N      = COALESCE([Wijnen gestopt], 0)
			VAR Gemist = COALESCE([Omzet gemist], 0)
			VAR Onderwerp = IF(N = 1, " wijn gestopt", " wijnen gestopt")
			VAR Staart =
			    IF(Gemist > 0,
			        IF(N = 1, ", goed voor ", ", samen goed voor ") &
			        FORMAT(Gemist, "€ #,##0", "nl-NL") & " omzet in de twaalf maanden daarvoor.",
			        ", zonder omzet in de twaalf maanden daarvoor."
			    )
			RETURN
			    IF(N > 0, FORMAT(N, "#,##0", "nl-NL") & Onderwerp & Staart, "")
		lineageTag: 944c0463-9039-4ee1-bab5-01450ae8fdd3

	/// Alias van [Omzet] puur voor de legenda: Power BI toont de measurenaam (8.2).
	measure 'Dit jaar' = [Omzet]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 769791fc-297f-4cfb-81de-f5c285084658

	/// Alias van [Omzet vorig jaar] voor de legenda.
	measure 'Vorig jaar' = [Omzet vorig jaar]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 3ed0115a-6712-49a2-b167-af60892f5843

	/// Venster expliciet in de subregel: 8a en 8b tonen geld uit verschillende jaren (9).
	measure 'Portfolio actief subregel' = [Omzet actief label] & " · " & FORMAT(COALESCE([Flessen actief], 0), "#,##0", "nl-NL") & " fl. — laatste 12 mnd"
		lineageTag: 243a2775-83bc-469d-aaf7-b55a5f8192ef

	/// Vorige venster, niet het huidige - zie 3.4.
	measure 'Portfolio gestopt subregel' = [Omzet gemist label] & " · " & FORMAT(COALESCE([Flessen gemist], 0), "#,##0", "nl-NL") & " fl. — vorige 12 mnd"
		lineageTag: f820ddbe-8a3d-4a95-b42d-d1ee2a06cb7b

	/// 'eerder besteed', niet 'potentieel': er bestaat geen onderbouwde potentieelschatting (3.4).
	measure 'Portfolio kans subregel' = [Kans eerdere omzet label] & " eerder besteed"
		lineageTag: 6ef41bb5-2428-4318-99c7-0d736ba95883

	/// Numerieke status voor Type 2 regels in de wijnentabel. Een measure, geen kolomverwijzing: een kolom in de conditie dwingt Power BI die kolom als extra rijniveau toe te voegen.
	measure Statuscode =
			SWITCH(SELECTEDVALUE(fct_klant_product[regelstatus], ""),
			    "actief", 1,
			    "gestopt", 2,
			    "kans", 3,
			    0)
		formatString: 0
		isHidden
		lineageTag: afec4043-0621-46c7-a3ee-44eb2a23ba50

	/// Brutomarge over de laatste 12 maanden, uit de mart.
	measure 'Brutomarge 12m' = SUM(fct_klant[brutomarge_12m])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 55ab27cd-0880-4277-9c12-1304b28c9c86

	/// Niet [Brutomarge % 12m] gebruiken: die deelt door [Omzet 12m], wat in dit model de fct_voorraad-meting is, niet de klantomzet. Levert 2,7% i.p.v. 51%.
	measure 'Brutomarge pct 12m' = DIVIDE(SUM(fct_klant[brutomarge_12m]), SUM(fct_klant[omzet_12m]))
		formatString: 0%
		lineageTag: 247bb60f-f0a1-469f-a7c3-03a9d990a4e3

	measure 'Brutomarge 12m label' = FORMAT(COALESCE([Brutomarge 12m], 0), "€ #,##0", "nl-NL")
		lineageTag: 702dc31a-aac2-4a26-9753-cda44ec00106

	measure 'Brutomarge pct label' =
			VAR P = [Brutomarge pct 12m]
			RETURN IF(ISBLANK(P), "geen margegegevens",
			    FORMAT(P, "0%", "nl-NL") & " marge op " & [Omzet 12m rollend label])
		lineageTag: 3a39e4c1-6c0a-4978-9eca-b4d2fced4a4d

	/// Volume per wijn per maand. is_revenue, niet is_stock_movement: die telt gratis samples mee en de hele pagina is revenue-consistent (3.2).
	measure 'Flessen per maand' = CALCULATE(SUM(fct_sales[aantal]), fct_sales[is_revenue] = TRUE())
		formatString: #,0
		lineageTag: 02f9c147-84f5-4b54-8d56-f5fa605b58dd

	/// Filtert lege regels uit de wijnentabel: kans-wijnen met alleen een prijsafspraak en gestopte wijnen waarvan ook het vorige venster leeg is, tonen 0 flessen en 0 omzet en dragen niets bij. Toetst dezelfde twee measures die de tabel toont, zodat het filter matcht met wat de gebruiker ziet.
	measure 'Regel heeft data' = IF(COALESCE([Omzet tabel], 0) > 0 || COALESCE([Flessen tabel], 0) > 0, 1, 0)
		formatString: 0
		isHidden
		lineageTag: 93ca1715-9527-4f48-b6d6-c766160cec5f

	/// Paginafilter voor Klant algemeen: consumenten zijn 406 van 774 klanten maar 2,7% van de omzet. Wordt op klantrij-niveau geevalueerd en is dus grain-safe.
	measure 'Zakelijke klant' =
			VAR B = SELECTEDVALUE(fct_klant[branche])
			RETURN IF(ISBLANK(B) || B = "Consument", 0, 1)
		formatString: 0
		isHidden
		lineageTag: 08faf4d5-b263-464d-b8b9-157c9af67614

	measure 'Klant marge 12m' = SUM(fct_klant[brutomarge_12m])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 4469b96d-e586-42f6-a5cb-618372abdb27

	/// Keuze uit de losstaande parameter-tabel; valt terug op 20.
	measure 'TopN waarde' = SELECTEDVALUE('TopN keuze'[Aantal], 20)
		formatString: 0
		lineageTag: 92f4b0a0-8a2e-40a8-9355-558b00226425

	/// Rangschikt over klant_label, niet klant_naam: de visuals groeperen op klant_label en een RANKX over een andere kolom levert rang 1 voor elke rij.
	measure 'Klantrang omzet' =
			IF(NOT ISBLANK([Klant omzet 12m]),
			    RANKX(ALLSELECTED(fct_klant[klant_label]), [Klant omzet 12m], , DESC, DENSE))
		formatString: 0
		lineageTag: 64723e84-d91c-43c7-b100-0834eb64f2a1

	measure 'Klantrang marge' =
			IF(NOT ISBLANK([Klant marge 12m]),
			    RANKX(ALLSELECTED(fct_klant[klant_label]), [Klant marge 12m], , DESC, DENSE))
		formatString: 0
		lineageTag: 2639de02-599d-47d5-8e1c-9e1db802400e

	measure 'In top N' = IF([Klantrang omzet] <= [TopN waarde], 1, 0)
		formatString: 0
		isHidden
		lineageTag: c219c248-0186-40dc-a2b3-14641bd7ece1

	/// Noemer voor de concentratiecijfers. Niet [Klanten met omzet] op fct_sales: die telt all-time en inclusief consumenten.
	measure 'Zakelijke klanten met omzet' =
			COUNTROWS(
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0
			            && fct_klant[branche] <> "Consument"
			            && NOT ISBLANK(fct_klant[branche])
			    )
			)
		formatString: #,0
		lineageTag: 3dfed271-6276-46f4-a947-74ce9e018a03

	measure 'Zakelijke omzet 12m' =
			SUMX(
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0
			            && fct_klant[branche] <> "Consument"
			            && NOT ISBLANK(fct_klant[branche])
			    ),
			    fct_klant[omzet_12m]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: eabfb34f-e2c4-4c82-8f1d-fd3401caab1e

	measure 'Aandeel top 10 pct omzet' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[omzet_12m])
			VAR Grens = ROUND(Aantal * 0.1, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[omzet_12m], DESC), fct_klant[omzet_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 11a86e9b-6a60-4a02-9953-23312e4d838b

	measure 'Aandeel top 20 pct omzet' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[omzet_12m])
			VAR Grens = ROUND(Aantal * 0.2, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[omzet_12m], DESC), fct_klant[omzet_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 80ec3b61-673e-437e-934a-bba6c11833b4

	measure 'Aandeel top 10 pct marge' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[brutomarge_12m])
			VAR Grens = ROUND(Aantal * 0.1, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[brutomarge_12m], DESC), fct_klant[brutomarge_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 418afdc1-1837-48db-a454-84d991434aa7

	measure 'Aandeel top 20 pct marge' =
			VAR Populatie =
			    FILTER(
			        ALLSELECTED(fct_klant),
			        fct_klant[omzet_12m] > 0 && fct_klant[branche] <> "Consument" && NOT ISBLANK(fct_klant[branche])
			    )
			VAR Aantal = COUNTROWS(Populatie)
			VAR Totaal = SUMX(Populatie, fct_klant[brutomarge_12m])
			VAR Grens = ROUND(Aantal * 0.2, 0)
			RETURN DIVIDE(SUMX(TOPN(Grens, Populatie, fct_klant[brutomarge_12m], DESC), fct_klant[brutomarge_12m]), Totaal)
		formatString: 0.0%
		lineageTag: 55ea1ffd-efc4-43f1-a92e-9c90e299a99c

	/// Pareto-lijn over klant_label, passend bij de groepering van de grafiek.
	measure 'Cumulatief omzet pct' =
			VAR R = [Klantrang omzet]
			VAR Zichtbaar = ALLSELECTED(fct_klant[klant_label])
			VAR Totaal = CALCULATE([Klant omzet 12m], Zichtbaar)
			RETURN
			    IF(NOT ISBLANK(R),
			        DIVIDE(
			            SUMX(FILTER(Zichtbaar, [Klantrang omzet] <= R), [Klant omzet 12m]),
			            Totaal
			        )
			    )
		formatString: 0.0%
		lineageTag: d897a6ef-b981-47ee-b166-9739a9c05226

	measure 'Zakelijke klanten label' = FORMAT([Zakelijke klanten met omzet], "#,##0", "nl-NL")
		lineageTag: 1b5677f6-3dca-4dcf-af8a-935c6b1cac74

	measure 'Zakelijke omzet label' = FORMAT([Zakelijke omzet 12m], "€ #,##0", "nl-NL")
		lineageTag: d3a50b5c-17c6-4dd1-8936-bcdf884fb865

	measure 'Top 10 pct omzet label' = FORMAT([Aandeel top 10 pct omzet], "0.0%", "nl-NL")
		lineageTag: 64c81e97-1371-4373-b47b-9066f0ba61a8

	measure 'Top 20 pct omzet label' = FORMAT([Aandeel top 20 pct omzet], "0.0%", "nl-NL")
		lineageTag: 1d0bbefb-7828-46a8-9ade-bb20919a4725

	measure 'Top 10 pct marge label' = FORMAT([Aandeel top 10 pct marge], "0.0%", "nl-NL")
		lineageTag: bbd7194e-a272-4eb6-aa57-c85e02fb9604

	measure 'Top 20 pct marge label' = FORMAT([Aandeel top 20 pct marge], "0.0%", "nl-NL")
		lineageTag: 62113eed-da44-43e8-8bf5-514196e300c0

	measure 'Top 10 pct aantal label' = FORMAT(ROUND([Zakelijke klanten met omzet] * 0.1, 0), "#,##0", "nl-NL") & " van " & FORMAT([Zakelijke klanten met omzet], "#,##0", "nl-NL") & " klanten"
		lineageTag: fe048d1f-a656-40de-b1f5-2945a40dbd9a

	measure 'Top 20 pct aantal label' = FORMAT(ROUND([Zakelijke klanten met omzet] * 0.2, 0), "#,##0", "nl-NL") & " van " & FORMAT([Zakelijke klanten met omzet], "#,##0", "nl-NL") & " klanten"
		lineageTag: 6fefd715-af09-422d-91ea-c785ece78074

	measure 'Klant algemeen subregel' = "Zakelijke klanten · laatste 12 maanden · " & FORMAT([Zakelijke klanten met omzet], "#,##0", "nl-NL") & " klanten met omzet · consumenten uitgesloten"
		lineageTag: f166c83b-8ab0-46ba-9ce5-fe6a11e326f9

	/// Eerste order binnen 60 dagen voor de peildatum.
	measure 'Nieuwe klant 60d' =
			VAR D = SELECTEDVALUE(fct_klant[eerste_order_datum])
			RETURN IF(NOT ISBLANK(D) && D >= [Peildatum] - 60, 1, 0)
		formatString: 0
		isHidden
		lineageTag: 35db413a-747b-4246-80b6-bff1a77094cf

	/// Actieve segmenten die 21+ dagen niet besteld hebben - de belronde. Niet alle 248 achterstallige klanten: die bevatten klanten die jaren geleden vertrokken.
	measure 'Stil 21 dagen' =
			VAR D = SELECTEDVALUE(fct_klant[dagen_sinds_laatste_order])
			VAR S = SELECTEDVALUE(fct_klant[klant_segment])
			RETURN IF(NOT ISBLANK(D) && D > 21 && S IN { "kern", "actief", "nieuw" }, 1, 0)
		formatString: 0
		isHidden
		lineageTag: 3b5ba791-345a-4a25-aaef-74a95309f975

	measure 'Eerste order label' =
			VAR D = SELECTEDVALUE(fct_klant[eerste_order_datum])
			RETURN IF(NOT ISBLANK(D), FORMAT(D, "d MMM yyyy", "nl-NL"))
		lineageTag: 57842732-0936-4262-b5ff-91c8333b31e5

	measure 'Dagen stil' = SELECTEDVALUE(fct_klant[dagen_sinds_laatste_order])
		formatString: #,0
		lineageTag: cde625ec-ddc7-4efb-8851-bdb13b51db4e

	measure 'Klant segment' = SELECTEDVALUE(fct_klant[klant_segment])
		lineageTag: 0b46d2b5-5816-4595-b4ca-91db9a9dc1a4

	measure 'Klant marge pct' = DIVIDE([Klant marge 12m], [Klant omzet 12m])
		formatString: 0%
		lineageTag: e9d45a71-62e4-4526-a302-3f1eea2a6db0

	/// Visual-filter voor de Pareto en de Top-N tabel. [Zakelijke klant] alleen laat 207 zakelijke klanten zonder 12-maands omzet toe, die als nulbalken zouden verschijnen.
	measure 'Zakelijke klant met omzet' = IF([Zakelijke klant] = 1 && [Klant omzet 12m] > 0, 1, 0)
		formatString: 0
		isHidden
		lineageTag: 9aa22fb7-597b-4909-b636-89595ecdbbab

	column _
		lineageTag: d79b2a64-f07a-4ba9-affb-d93dfbe19461
		isNameInferred
		sourceColumn: [_]

	partition _Metingen = calculated
		mode: import
		source = ROW("_", BLANK())

