	/// Stuurt zowel de rangschikking als de volgorde van de ranglijst. Valt terug op omzet.
	measure 'Product sorteerwaarde' =
			SWITCH(
			    SELECTEDVALUE('Sortering producten'[Sortering], "Omzet"),
			    "Flessen",    [Wijn flessen 12m],
			    "Brutomarge", [Brutomarge],
			    [Omzet 12m]
			)
		lineageTag: 334a3b52-5b1c-4f78-aff8-38018a6ca764

	/// Rangschikt over product_label, de kolom waarop de ranglijst groepeert. Een RANKX over een andere kolom levert rang 1 voor elke rij.
	measure Productrang =
			IF(
			    NOT ISBLANK([Product sorteerwaarde]),
			    RANKX(ALLSELECTED(fct_voorraad[product_label]), [Product sorteerwaarde], , DESC, DENSE)
			)
		formatString: 0
		lineageTag: f18ce8ff-698e-4df1-a242-4f6bde57065a

	/// Expliciete ISBLANK-guard: BLANK() <= 50 is waar in DAX, waardoor de lege 'unknown member'-rij van dim_product anders in de ranglijst zou verschijnen.
	measure 'In top N producten' =
			VAR R = [Productrang]
			RETURN IF(NOT ISBLANK(R) && R <= SELECTEDVALUE('TopN producten'[Aantal], 50), 1, 0)
		formatString: 0
		isHidden
		lineageTag: 0341ac2b-d00d-4c35-af35-56ccb965cc35

	measure 'Wijnen met omzet label' = FORMAT([Wijnen met omzet], "#,##0", "nl-NL")
		lineageTag: 89755e05-f8fd-45d4-ae9e-7435a23d53f5

	measure 'Product omzet label' = FORMAT([Omzet 12m], "€ #,##0", "nl-NL")
