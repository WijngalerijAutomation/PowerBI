	/// Noemt de basis: de prognose volgt de seizoensvorm van vorig jaar, niet het dagtempo.
	measure 'Prognose subregel' =
			VAR Rest = [Prognose rest van jaar]
			VAR Jr = YEAR([Peildatum]) - 1
			RETURN IF(ISBLANK(Rest), "",
			    FORMAT(Rest, "€ #,##0", "nl-NL") & " te gaan · op basis van de vorm van " & FORMAT(Jr, "0"))
		lineageTag: 9a044217-158d-4e02-b5a6-6c14c73f3668

	measure 'CEO kopregel sub' =
			"1 jan t/m " & FORMAT([Peildatum], "d MMM yyyy", "nl-NL") &
			" · vergeleken met dezelfde periode " & FORMAT(YEAR([Peildatum]) - 1, "0")
		lineageTag: 89b46418-5718-47b4-9656-1bfaf59351c6

	/// Cumulatief per maand, alleen t/m de maand van de peildatum. Loopt niet door na de peildatum: een vlakke lijn daarna leest als omzet die stilvalt.
	measure 'Omzet cumulatief dit jaar' =
			VAR Jr = YEAR([Peildatum])
			VAR Mp = MONTH([Peildatum])
			VAR M  = MAX(dim_date[maand_nr])
			RETURN
			    IF(M <= Mp,
			        CALCULATE([Omzet], REMOVEFILTERS(dim_date), dim_date[jaar] = Jr, dim_date[maand_nr] <= M))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 9002c061-5314-499e-ab34-4589a8cec0c1

	measure 'Omzet cumulatief vorig jaar' =
			VAR Jr = YEAR([Peildatum]) - 1
			VAR M  = MAX(dim_date[maand_nr])
			RETURN CALCULATE([Omzet], REMOVEFILTERS(dim_date), dim_date[jaar] = Jr, dim_date[maand_nr] <= M)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 5c912a8d-b3b2-4196-9a44-02672e045777

	/// Verankerd op de gerealiseerde YTD-omzet en daarna opgehoogd met de resterende maanden van vorig jaar maal de groei. Niet 'vorig jaar cumulatief maal groei': dat zou in de peildatum-maand boven de realisatie uitkomen puur omdat die maand nog niet af is. Eindigt in december exact op [Prognose omzet jaar].
	measure 'Prognose cumulatief' =
			VAR Jr = YEAR([Peildatum]) - 1
			VAR Mp = MONTH([Peildatum])
			VAR M  = MAX(dim_date[maand_nr])
			VAR VorigCum = CALCULATE([Omzet], REMOVEFILTERS(dim_date), dim_date[jaar] = Jr, dim_date[maand_nr] <= M)
			VAR Groei = [Omzet YTD groei]
			RETURN
			    IF(M >= Mp,
			        [Omzet YTD dit jaar] + (VorigCum - [Omzet YTD vorig jaar]) * (1 + Groei))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 92d831eb-104e-4ad6-886a-e2e6f8811a8d

	measure 'Orders YTD groei label' =
			VAR G = [Orders YTD groei]
			RETURN IF(ISBLANK(G), "", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: 477c10e9-0fd3-466e-9392-ab2deb1006cd

	measure 'Gem. orderwaarde YTD groei label' =
			VAR G = [Gem. orderwaarde YTD groei]
			RETURN IF(ISBLANK(G), "", IF(G >= 0, "↗ ", "↘ ") & FORMAT(ABS(G), "0.0%", "nl-NL"))
		lineageTag: 03a3599b-1922-440e-a14b-5fe08d50e505

