table fct_sales
	lineageTag: 0736954c-b332-4d10-8784-40996fcd8a71

	measure Omzet = CALCULATE(SUM(fct_sales[regel_totaal]), fct_sales[is_revenue] = TRUE())
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: cc8a5479-ac98-452b-8c8e-998e531856b3

	measure Flessen = CALCULATE(SUM(fct_sales[aantal]), fct_sales[is_stock_movement] = TRUE())
		formatString: #,0
		lineageTag: baf46d01-4d64-41b6-a9f3-6a8c61ab84e5

	measure Orders = CALCULATE(DISTINCTCOUNT(fct_sales[ordernummer]), fct_sales[is_revenue] = TRUE())
		formatString: 0.00
		lineageTag: 191adde1-6c67-43a2-a5a0-e20321e6d8f7

	measure 'Klanten met omzet' = CALCULATE(DISTINCTCOUNT(fct_sales[klant_id]), fct_sales[is_revenue] = TRUE())
		formatString: 0
		lineageTag: 745014f1-68ad-43d2-b904-3f0a528715fc

	measure 'Gem. orderwaarde' = DIVIDE([Omzet], [Orders])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 5ec75913-f37b-453d-9501-fd841c858e3d

	measure 'Omzet vorig jaar' = CALCULATE([Omzet], SAMEPERIODLASTYEAR(dim_date[datum]))
		lineageTag: c9e443e4-01b8-42d3-9e80-73cd102aed45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet groei %' = DIVIDE([Omzet] - [Omzet vorig jaar], [Omzet vorig jaar])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9939e1c9-df73-4bd8-a973-4849b7fe7855

