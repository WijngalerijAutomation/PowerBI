table fct_voorraad
	lineageTag: 074b9ca6-316b-454b-a6a9-87adfca23055

	measure 'Totale voorraadwaarde' = SUM(fct_voorraad[voorraadwaarde])
		lineageTag: 74a51fba-760d-4e6d-b1f0-efcb7ea06fd4

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Voorraadwaarde label' = "€ " & FORMAT([Totale voorraadwaarde], "#,##0", "nl-NL") & ",-"
		lineageTag: fce9ec3d-0a07-4c08-a51d-e90480523bed

		changedProperty = IsHidden

	measure 'Voorraad flessen' = SUM(fct_voorraad[voorraad])
		formatString: 0
		lineageTag: e4275cff-74c4-40cf-a12e-e5cd2b3593c8

		changedProperty = IsHidden

	/// Winsorised vraag (2026-08-20, was gem_per_week_12w) - consistent met de dekking_weken-kolom in de mart. De ongecorrigeerde rates staan in [Vraag per week 12w]/[52w].
	measure 'Vraag per week' = SUM(fct_voorraad[vraag_per_week])
		lineageTag: 0c84e7fa-aa8c-4332-90a6-3a72259e19b7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Weken dekking op EFFECTIEVE voorraad: (voorraad + in_bestelling - gereserveerd) / vraag per week. ZICHTBAAR sinds 2026-08-20: effectieve voorraad bestaat nu gevalideerd in de mart, afgeleid uit de ERP-orders en -inkoop. De oude definitie op ruwe voorraad negeerde gereserveerde en inkomende flessen in tegengestelde richtingen en was daarom verborgen - zie de mart-header van fct_voorraad_db voor de validatie.
	measure 'Dekking weken' = DIVIDE(SUM(fct_voorraad[effectieve_voorraad]), [Vraag per week])
		formatString: 0.0
		lineageTag: 17cf8434-5d54-4e38-9f94-8aa6b66de819

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Brutomarge = SUM(fct_voorraad[brutomarge_12m])
		lineageTag: 589330fa-725c-4415-9fc0-9dd676f630b7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet 12m' = SUM(fct_voorraad[omzet_12m])
		lineageTag: 5153112a-9d0e-4411-8085-7bf1d9fb28a0

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brutomarge %' = DIVIDE([Brutomarge], [Omzet 12m])
		lineageTag: 0fd32d6d-56cf-4324-9f9a-4bdf27ee7576

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Aantal wijnen' = COUNTROWS(fct_voorraad)
		formatString: 0
		lineageTag: 6ff4bc7b-644c-4cd8-8864-1d4d2c6dd531

		changedProperty = IsHidden

	measure 'Voorraad flessen label' = FORMAT([Voorraad flessen], "#,##0", "nl-NL")
		lineageTag: cdc0020c-ca0b-48ff-8fa1-d1ac4e5369f5

		changedProperty = IsHidden

	measure 'Vraag per week label' = FORMAT([Vraag per week], "#,##0.0", "nl-NL")
		lineageTag: a11c59d0-ae16-445d-9f8e-8fbe2cd4c945

		changedProperty = IsHidden

	/// Nederlandse weergave van [Dekking weken]. Zichtbaar sinds 2026-08-20, samen met de basismeting - die rekent nu op effectieve voorraad.
	measure 'Dekking label' = FORMAT([Dekking weken], "0.0", "nl-NL") & " weken"
		lineageTag: ea9bedce-ca27-41ce-9842-17bdb0f8f322

