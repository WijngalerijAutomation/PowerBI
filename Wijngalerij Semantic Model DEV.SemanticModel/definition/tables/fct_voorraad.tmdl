	partition fct_voorraad = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("ep-soft-salad-agt3f5p2.c-2.eu-central-1.aws.neon.tech:5432", "neondb"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "fct_voorraad_db"]}[Data],
				  // product_id arrives as Int64 from fct_voorraad_db; cast to text so the
				  // relationship to dim_product still resolves and so the DAX equality with
				  // fct_klant_product[product_id] still matches — both sides are then text.
				  // dim_product stays on the scraper-sourced mart (string product_id).
				  // Remove this step when dim_product also moves to the _db source.
				  #"Changed Type" = Table.TransformColumnTypes(#"Navigation 1", {{"product_id", type text}})
				in
				  #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

