	/// Unieke weergavenaam: product_naam is niet uniek (737 namen voor 740 producten). Voegt de artikelcode toe waar namen botsen, net als fct_klant[klant_label].
	column product_label =
			VAR Voorkomens =
			    CALCULATE(COUNTROWS(fct_voorraad), ALLEXCEPT(fct_voorraad, fct_voorraad[product_naam]))
			RETURN
			    IF(Voorkomens > 1,
			        fct_voorraad[product_naam] & " (" & fct_voorraad[artikelcode] & ")",
			        fct_voorraad[product_naam])
		dataType: string
		lineageTag: 02e98ce9-219a-43ab-921f-a75477bf100d
		summarizeBy: none

	/// 0 voor de dienstregels Accijns, Divers, Statiegeld, Transport, Vrachtkosten en Verzending (en voor de lege unknown-member rij), 1 voor echte producten. Kolom en geen measure: een kolomfilter werkt voor het groeperen en is dus grain-safe. Niet afleiden uit een lege artikelcode - Poujol Lacoste Blanc, Villa Blanche Chardonnay en Ruinart hebben er ook geen.
	column is_wijn =
			VAR N = fct_voorraad[product_naam]
			RETURN
			    IF(
			        ISBLANK(N) || N IN {"Accijns", "Divers", "Statiegeld", "Transport", "Vrachtkosten", "Verzending"},
			        0,
			        1
			    )
		dataType: int64
		lineageTag: 8874d6a7-b66a-4681-8724-923346849ba2
		summarizeBy: none

	/// Omzet in het vorige 12-maandsvenster, opgeteld uit fct_klant_product. Die mart heeft omzet_12m en omzet_vorige_12m als gekoppeld paar en het huidige venster sluit exact aan op fct_voorraad[omzet_12m]. SUMX over ALL() en geen CALCULATE: CALCULATE doet contexttransitie in een berekende kolom en maakt de kolom afhankelijk van de hele tabel, wat een circulaire afhankelijkheid geeft met de andere venster-kolommen.
	column omzet_vorige_12m =
			VAR Pid = fct_voorraad[product_id]
			RETURN
			    SUMX(
			        FILTER(ALL(fct_klant_product), fct_klant_product[product_id] = Pid),
			        fct_klant_product[omzet_vorige_12m]
			    )
		dataType: double
		lineageTag: 498e02ce-acb2-4aee-9e3d-b259b36fd968
		summarizeBy: sum

	column flessen_vorige_12m =
			VAR Pid = fct_voorraad[product_id]
			RETURN
			    SUMX(
			        FILTER(ALL(fct_klant_product), fct_klant_product[product_id] = Pid),
			        fct_klant_product[flessen_vorige_12m]
			    )
		dataType: double
		lineageTag: 8ad1cf22-d032-4c0a-8568-2cd1eb148fc7
		summarizeBy: sum

	/// Zakelijke klanten met omzet op deze wijn in het vorige venster. Zelfde afbakening als klanten_nu_zakelijk.
	column klanten_vorige_12m =
			VAR Pid = fct_voorraad[product_id]
			RETURN
			    COUNTROWS(
			        FILTER(
			            ALL(fct_klant_product),
			            fct_klant_product[product_id] = Pid
			                && fct_klant_product[is_zakelijk] = 1
			                && fct_klant_product[omzet_vorige_12m] > 0
			        )
			    )
		dataType: int64
		lineageTag: f60047d9-0e89-4017-94d5-c6ab2e354984
		summarizeBy: sum

	/// Hexkleur voor het groeicijfer op Productdetail. Een cardVisual kan zijn fontColor alleen datagestuurd maken via Aggregation(Min) over een kolom. Geen CALCULATE: dat geeft contexttransitie en circulaire afhankelijkheden tussen deze kolommen.
	column omzet_groei_kleur =
			VAR Nu = fct_voorraad[omzet_12m]
			VAR Vorig = fct_voorraad[omzet_vorige_12m]
			RETURN IF(ISBLANK(Vorig) || Vorig = 0 || Nu >= Vorig, "#1F9D55", "#CC3B2F")
		dataType: string
		lineageTag: f8486b43-fe7f-4ac3-8be6-682db3a2f1b9
		summarizeBy: none

	column flessen_groei_kleur =
			VAR Nu = fct_voorraad[flessen_52w]
			VAR Vorig = fct_voorraad[flessen_vorige_12m]
			RETURN IF(ISBLANK(Vorig) || Vorig = 0 || Nu >= Vorig, "#1F9D55", "#CC3B2F")
		dataType: string
		lineageTag: e03a70df-626b-4944-8ffd-b255e1161ccf
		summarizeBy: none

	column klanten_groei_kleur =
			VAR Nu = fct_voorraad[klanten_nu_zakelijk]
			VAR Vorig = fct_voorraad[klanten_vorige_12m]
			RETURN IF(ISBLANK(Vorig) || Vorig = 0 || Nu >= Vorig, "#1F9D55", "#CC3B2F")
		dataType: string
		lineageTag: 95ad3017-4428-4bc4-b64b-3c032eeee0da
		summarizeBy: none

	column prijs_groei_kleur =
			VAR NuPrijs = DIVIDE(fct_voorraad[omzet_12m], fct_voorraad[flessen_52w])
			VAR VorigPrijs = DIVIDE(fct_voorraad[omzet_vorige_12m], fct_voorraad[flessen_vorige_12m])
			RETURN IF(ISBLANK(VorigPrijs) || VorigPrijs = 0 || NuPrijs >= VorigPrijs, "#1F9D55", "#CC3B2F")
		dataType: string
		lineageTag: 6e1af692-ba18-4128-ad9e-6740da8069ba
		summarizeBy: none

	/// Zakelijke klanten met omzet op deze wijn in het huidige venster. Tegenhanger van klanten_vorige_12m, zodat de groei appels met appels vergelijkt. Niet fct_voorraad[n_klanten]: die telt alle klanten inclusief consumenten en telt ook regels zonder omzet mee.
	column klanten_nu_zakelijk =
			VAR Pid = fct_voorraad[product_id]
			RETURN
			    COUNTROWS(
			        FILTER(
			            ALL(fct_klant_product),
			            fct_klant_product[product_id] = Pid
			                && fct_klant_product[is_zakelijk] = 1
			                && fct_klant_product[omzet_12m] > 0
			        )
			    )
		dataType: int64
		lineageTag: b48156e1-d710-4171-814f-f4261deac488
		summarizeBy: sum

	/// Flessen op open verkooporders (status Nieuw - verwerken / Backorder). Afgeleid uit de ERP-database en exact gevalideerd tegen de voorraadpagina (48/48 producten). Klaargezette orders reserveren NIET - die voorraad is al afgeboekt.
	column gereserveerd
