table fct_klant
	lineageTag: 54e3d4a2-2797-4683-85ef-4171ab30f526

	measure Klanten = COUNTROWS(fct_klant)
		formatString: 0
		lineageTag: 456b31da-f32a-4ec8-8a7a-3cc41cc6760f

		changedProperty = IsHidden

	measure 'Actieve klanten' = CALCULATE([Klanten],fct_klant[klant_segment] IN {"kern","actief","nieuw"})
		formatString: 0
		lineageTag: b1a3fff1-b2c3-4bcc-930a-45685a7958b7

		changedProperty = IsHidden

	measure 'Klant omzet 12m' = SUM(fct_klant[omzet_12m])
		lineageTag: bc8f545a-75c5-4037-a0cd-ebe9711c9881

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet totaal' = SUM(fct_klant[omzet_totaal])
		lineageTag: 542e04dd-55b8-4f30-add2-0b72aed16c1b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gem. orderwaarde klant' = DIVIDE([Omzet totaal], SUM(fct_klant[n_orders_verkocht]))
		lineageTag: 85f04e2c-3eaa-4a70-ab14-772edff7af3f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mediane orderwaarde' = MEDIANX(FILTER(fct_klant, fct_klant[n_orders_verkocht] > 0),fct_klant[gem_orderwaarde])
		lineageTag: 570c4c25-74e3-4b5e-887f-24e01117495e

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Deelde eerder door [Omzet 12m], wat in dit model SUM(fct_voorraad[omzet_12m]) is - de voorraadtabel, niet de klantomzet. Gaf 2,7% i.p.v. 51,1% op Beachclub C. Deelt nu door de klantomzet uit dezelfde tabel.
	measure 'Brutomarge % 12m' = DIVIDE(SUM(fct_klant[brutomarge_12m]), SUM(fct_klant[omzet_12m]))
		formatString: 0%
		lineageTag: 6db1dbb9-7f82-4ea0-986f-eeb5e3ad416d

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet top 10 %' = DIVIDE(CALCULATE([Omzet totaal], fct_klant[omzet_rang] <= 10),CALCULATE([Omzet totaal], ALL(fct_klant)))
		lineageTag: 8fa8d902-18ed-411c-80b6-6c36f48e5cbc

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Klanten label' = FORMAT([Actieve klanten], "#,##0", "nl-NL")
		lineageTag: 7b5346f2-e9b9-4695-82b9-372c49e6ad61

		changedProperty = IsHidden

	measure 'Top 10 aandeel label' = FORMAT([Omzet top 10 %], "0,0%", "nl-NL")
		lineageTag: fb114b51-a58c-40d2-bdb7-ff3d7c7adb8f

		changedProperty = IsHidden

	measure Measure
		lineageTag: c3276c65-f107-4abe-a6db-196c5f01c98d

		changedProperty = IsHidden

	measure 'Klant Omzet 12m label' = FORMAT([Klant omzet 12m], "€ #,##0", "nl-NL") & ",-"
		lineageTag: 59fa4f44-51da-4f8d-a489-a6290a8d896a

	measure 'Omzet YTD' = TOTALYTD([Omzet], dim_date[datum])
		lineageTag: b1a86e47-623a-44ec-a79f-ef92eca13d20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet groei JoJ' =
			VAR Basis = SUM(fct_klant[omzet_zelfde_6m_vorig_jaar])
			                  RETURN IF(Basis >= 500,
			                      DIVIDE(SUM(fct_klant[omzet_6m]), Basis) - 1)
		lineageTag: 3d75a952-3b82-485c-9f65-822737374239

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Omzet YTD label' = FORMAT([Omzet YTD], "€ #,##0", "nl-NL")& ",-"
		lineageTag: e5bc9f55-e970-4be0-8a36-175af445ffc6

	measure 'Omzet groei JoJ label' = FORMAT([Omzet groei JoJ], "0,0%", "nl-NL")
		lineageTag: 5230baac-32a3-47ca-a2d4-7d1dcb6ee350

