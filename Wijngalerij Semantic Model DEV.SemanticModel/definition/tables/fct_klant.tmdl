	/// Hex voor de signaalbanner. Type 6 field-driven kleur vereist een fysieke kolom, geen measure.
	column signaal_kleur =
			VAR Basis = fct_klant[omzet_zelfde_6m_vorig_jaar]
			VAR G = IF(Basis >= 500, DIVIDE(fct_klant[omzet_6m], Basis) - 1)
			RETURN IF(NOT ISBLANK(G) && G <= -0.10, "#FDECEA", "#F2F5F2")
		dataType: string
		lineageTag: 71be25d7-93a3-4330-9e55-fde9df5366b0
		summarizeBy: none

	column signaal_tekstkleur =
			VAR Basis = fct_klant[omzet_zelfde_6m_vorig_jaar]
			VAR G = IF(Basis >= 500, DIVIDE(fct_klant[omzet_6m], Basis) - 1)
			RETURN IF(NOT ISBLANK(G) && G <= -0.10, "#A2515F", "#1B2523")
		dataType: string
		lineageTag: 8ddfbed3-a3aa-48e5-8882-bd6492b8f937
		summarizeBy: none

	column segment_kleur =
			SWITCH(fct_klant[klant_segment],
			    "kern", "#DCEAE7",
			    "actief", "#DCEAE7",
			    "nieuw", "#E8EFE4",
			    "afglijdend", "#FBEBE4",
			    "#F6E7EA")
		dataType: string
		lineageTag: 68f40b07-2adb-4f37-b733-66bb1b92093a
		summarizeBy: none

	column segment_tekstkleur =
			SWITCH(fct_klant[klant_segment],
			    "kern", "#577D79",
			    "actief", "#577D79",
			    "nieuw", "#5A7048",
			    "afglijdend", "#C3715C",
			    "#A2515F")
		dataType: string
		lineageTag: c482eba3-1a87-454d-aa41-6909b34be3f3
		summarizeBy: none

	/// Subregelkleur tegel A (7). Fysieke kolom omdat Type 6 geen measure accepteert.
	column groei_kleur =
			VAR G = [Omzet groei JoJ]
			RETURN SWITCH(TRUE(),
			    ISBLANK(G), "#8A9691",
			    G < 0, "#A2515F",
			    "#577D79")
		dataType: string
		lineageTag: f730101e-0cc1-4230-bcd9-e0ec1967ffa0
		summarizeBy: none

	/// Subregelkleur tegel D (7).
	column flessen_kleur =
			VAR V = [Flessen verschil 12m]
			RETURN SWITCH(TRUE(),
			    ISBLANK(V) || V = 0, "#8A9691",
			    V > 0, "#577D79",
			    "#A2515F")
		dataType: string
		lineageTag: 4827679c-b074-4de0-9f86-530083f2376d
		summarizeBy: none

	/// Unieke weergavenaam: 774 klanten delen 759 namen, 14 namen komen 2-3x voor. Groeperen op klant_naam voegt die klanten samen en laat SELECTEDVALUE leeglopen. Voegt het klant_id toe bij dubbele namen.
	column klant_label =
			VAR Voorkomens = CALCULATE(COUNTROWS(fct_klant), ALLEXCEPT(fct_klant, fct_klant[klant_naam]))
			RETURN IF(Voorkomens > 1, fct_klant[klant_naam] & " (" & fct_klant[klant_id] & ")", fct_klant[klant_naam])
		dataType: string
		lineageTag: 1a8934ee-6f75-4cbe-ac93-7d45a5b8d465
		summarizeBy: none

	/// Vulkleur voor de risicobadge. Wit als er geen risico is, zodat de badge wegvalt tegen het canvas: een lege string haalt de '--' weg maar laat anders een lege roze pil staan. Spiegelt de logica van [Risicovlag] op rijniveau.
	column risico_kleur =
			VAR R = fct_klant[recency_ratio]
			VAR Basis = fct_klant[omzet_zelfde_6m_vorig_jaar]
			VAR G = IF(Basis >= 500, DIVIDE(fct_klant[omzet_6m], Basis) - 1)
			VAR S = fct_klant[klant_segment]
			VAR HeeftRisico =
			    S IN { "verloren", "slapend" }
			    || (NOT ISBLANK(R) && R >= 3)
			    || (NOT ISBLANK(G) && G <= -0.25)
			RETURN IF(HeeftRisico, "#F6E7EA", "#FFFFFF")
		dataType: string
		lineageTag: ae8652f9-1eab-4b93-b4c2-96d0272ec03b
		summarizeBy: none

